# Database Configuration (SQLite for local edge, PostgreSQL for central server)
DATABASE_URL="sqlite:///./trolleywise.db"
# DATABASE_URL="postgresql://trolleywise_user:trolleywise_password@localhost:5432/trolleywise_db"

# Store & GST Invoicing Details
